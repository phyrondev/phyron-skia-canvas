    "linux-arm64-glibc.gz": "sha256:8b5de76a4ef8a511d42cff00acc66b45852bbc702e85e54ae5f5b21a853f1758",
    "linux-arm64-musl.gz": "sha256:ad156c0566618daa69616dcecdc14d0b68a8decc2efd08188e809e71ac5d8ed3",
    "linux-x64-glibc.gz": "sha256:50ca06b11fb7e220da72f54e1747ff136ced3a0cf1493de075967f8ce6d52f1a",
    "linux-x64-musl.gz": "sha256:d6afd42151969bcffc330017d13e330c2e675004508a00b0f960bc05391da686",
    "win32-arm64.gz": "sha256:f67feb64ca1de67b4918fd84ab3896a3850c28debfbb988944c9086c0982279a",
