    "linux-arm64-glibc.gz": "sha256:e701251d6d6047b654648c4ae7364fa33ad7e6674963895b3ccad7728757b72a",
    "linux-arm64-musl.gz": "sha256:ad030d0a78c022de1c393cfc64dfd70324ef6a6ac4782ef4e6a0bcd0b4d92f79",
